# Use uma senha exclusiva de pelo menos 7 caracteres. NÃO coloque .env no Git/ZIP.
RADAR_PASSWORD=SUBSTITUA-POR-SENHA-LONGA-E-ALEATORIA
# 1 = qualquer pessoa vê a lista de concursos (modo público, só leitura); 0 = tudo exige login.
RADAR_PUBLIC=1
# UF pré-selecionada na lista pública (ex.: SP). Vazio = Brasil inteiro.
RADAR_DEFAULT_UF=
# Para testes locais HTTP: 0. Na VPS com proxy HTTPS: 1.
RADAR_COOKIE_SECURE=1
# Gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Obrigatória apenas para ATIVAR MFA. Faça backup seguro da chave.
RADAR_MFA_ENCRYPTION_KEY=
# Retry após falha: a cada 15 minutos. Agenda normal: 00,03,06,... SP.
RADAR_RETRY_SECONDS=900
RADAR_DETAIL_LIMIT=50
# Até 3 domínios oficiais consultados em paralelo (limite permitido: 1 a 5).
RADAR_SOURCE_WORKERS=3
# Entre requisições ao mesmo domínio: mínimo 3s, máximo 60s (padrão 8s).
RADAR_DOMAIN_INTERVAL_SECONDS=30
# HTTP 403: suspender domínio 12h. HTTP 429: respeitar Retry-After; sem cabeçalho, suspender 3h.
# A suspensão é salva no banco e sobrevive a reinícios dos contêineres.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
